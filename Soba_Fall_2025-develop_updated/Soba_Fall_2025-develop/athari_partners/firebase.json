{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "catalystplan-bc7d9",
          "appId": "1:484793527356:web:965d49243b9ad624192739",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "catalystplan-bc7d9",
          "configurations": {
            "android": "1:484793527356:web:965d49243b9ad624192739",
            "ios": "1:484793527356:web:965d49243b9ad624192739",
            "macos": "1:484793527356:web:965d49243b9ad624192739",
            "web": "1:484793527356:web:965d49243b9ad624192739",
            "windows": "1:484793527356:web:965d49243b9ad624192739"
          }
        }
      }
    }
  }
}
